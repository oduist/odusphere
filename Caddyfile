# Caddy — OduSphere gateway (upstream-owned; imports the sphere-owned sphere.caddy).
#
# Per the headless convention (ODUSPHERE.md §5) Caddy is the single public entry
# point: it serves the static Astro site from /srv (mounted from website/dist) and
# reverse-proxies dynamic requests to Odoo. This file is the version-controlled,
# reviewable perimeter — where the path allowlist, body-size caps and security
# headers live. It flows in from upstream on updates (default 3-way merge); add
# THIS sphere's own routes in sphere.caddy, never here.
#
# NOTE: per-IP request rate limiting for the public /api/* endpoints is enforced
# in the application layer (odu_base), because stock Caddy has no rate-limit
# directive and we do not want the perimeter to depend on a third-party plugin.

:80 {
	root * /srv
	encode zstd gzip

	# Harden every response. Kept minimal so we don't fight the headers Odoo's
	# web client sets for itself.
	header {
		X-Content-Type-Options nosniff
		-Server
	}

	# Never expose the Odoo database manager (create/drop/dump/restore DBs) to the
	# public edge. Belt-and-braces with `list_db = False` in odoo.conf.
	@dbmanager path /web/database /web/database/*
	handle @dbmanager {
		respond 404
	}

	# Public REST endpoints of odu_* modules (e.g. /api/contact). Body-size capped
	# here as a first line of defence; the app enforces its own cap and rate limit.
	@api path /api/*
	handle @api {
		request_body {
			max_size 64KB
		}
		reverse_proxy odoo:8069
	}

	# Odoo backend: authenticated web client, JSON-RPC, bus, and the Book tool.
	@odoo path /web* /odoo* /json* /longpolling* /bus* /mail* /odu_book*
	handle @odoo {
		reverse_proxy odoo:8069
	}

	# Odoo bus / live connections — gevent worker, port 8072.
	handle /websocket {
		reverse_proxy odoo:8072
	}

	# Sphere-local routes (sphere-owned; see sphere.caddy). Kept here so a sphere
	# adds its own gateway routes without editing this upstream-owned Caddyfile.
	import sphere.caddy

	# Everything else — the static Astro site (SPA fallback to index.html), with a
	# baseline CSP scoped to the static content only (the Odoo proxy is untouched).
	handle {
		header {
			X-Frame-Options SAMEORIGIN
			Referrer-Policy strict-origin-when-cross-origin
			Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'self'"
		}
		try_files {path} {path}/ /index.html
		file_server
	}
}
