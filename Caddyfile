# Caddy — OduSphere gateway.
# Serves the static Astro site from /srv (mounted from website/dist) and proxies
# dynamic requests to Odoo. Per the headless convention, public REST endpoints of
# odu_* modules should live under /api/* (proxied below). The /odu_book/* route is
# proxied explicitly as a backend tool (the odu_book client action).

:80 {
	root * /srv
	encode gzip zstd

	# Odoo dynamic requests (HTTP worker, port 8069).
	@odoo path /web* /odoo* /json* /longpolling* /bus* /mail* /odu_book* /api*
	handle @odoo {
		reverse_proxy odoo:8069
	}

	# Odoo bus / live connections — gevent worker, port 8072.
	handle /websocket {
		reverse_proxy odoo:8072
	}

	# Everything else — the static Astro site (SPA fallback to index.html).
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
