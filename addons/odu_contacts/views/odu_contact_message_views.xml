<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contacts > Requests: the website contact submissions, triaged. -->

    <record id="view_odu_contact_message_list" model="ir.ui.view">
        <field name="name">odu.contact.message.list</field>
        <field name="model">odu.contact.message</field>
        <field name="arch" type="xml">
            <list string="Contact Requests" decoration-muted="state == 'done'">
                <field name="create_date" string="Received"/>
                <field name="name"/>
                <field name="email"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_odu_contact_message_kanban" model="ir.ui.view">
        <field name="name">odu.contact.message.kanban</field>
        <field name="model">odu.contact.message</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="activity_state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                        <field name="email" widget="email"/>
                        <div class="d-flex justify-content-end mt-2">
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_odu_contact_message_form" model="ir.ui.view">
        <field name="name">odu.contact.message.form</field>
        <field name="model">odu.contact.message</field>
        <field name="arch" type="xml">
            <form string="Contact Request">
                <header>
                    <field name="state" widget="statusbar" clickable="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="create_date" string="Received"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_odu_contact_message_search" model="ir.ui.view">
        <field name="name">odu.contact.message.search</field>
        <field name="model">odu.contact.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="message"/>
                <field name="user_id"/>
                <filter name="open" string="Open" domain="[('state', '!=', 'done')]"/>
                <separator/>
                <filter name="state_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="state_in_progress" string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="state_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="my_requests" string="My Requests"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned"
                        domain="[('user_id', '=', False)]"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Assigned To"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_odu_contact_requests" model="ir.actions.act_window">
        <field name="name">Requests</field>
        <field name="res_model">odu.contact.message</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_odu_contact_message_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No contact requests yet</p>
            <p>Messages submitted through your website's contact form land here for triage.</p>
        </field>
    </record>

</odoo>
