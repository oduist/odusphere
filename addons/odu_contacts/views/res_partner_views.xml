<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contacts > Contacts: the partner directory. No bespoke partner views —
         we reuse the framework's own res.partner list/form/kanban/search (Zero
         Bloat); only the window action and menu are ours. -->

    <record id="action_odu_contacts_partners" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first contact</p>
            <p>Keep your people and companies here — the counterparties of your OduSphere.</p>
        </field>
    </record>

</odoo>
