---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <div class="mx-auto max-w-3xl px-6 py-32 text-center">
    <p class="text-sm font-semibold text-brand-600">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Page not found</h1>
    <p class="mt-4 text-slate-600">That page isn't part of this sphere.</p>
    <a
      href="/"
      class="mt-8 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700"
    >
      &larr; Back home
    </a>
  </div>
</Base>
