---
import { site } from "../site.config";
---

<header class="sticky top-0 z-10 border-b border-slate-200/70 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight text-slate-900">{site.name}</a>
    <a
      href={site.cta.href}
      class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
    >
      {site.cta.label}
    </a>
  </div>
</header>
